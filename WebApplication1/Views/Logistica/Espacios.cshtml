@model IEnumerable<HorarioTaller>

@{
    ViewData["Title"] = "Espacios";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>
            <i class="bi bi-building"></i>
            Espacios utilizados
        </h1>

        <a asp-action="Agenda"
           class="btn btn-outline-primary">

            Volver a agenda
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay espacios registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Espacio</th>
                        <th>Fecha</th>
                        <th>Horario</th>
                        <th>Taller</th>
                        <th>Instructor</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var horario in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @horario.Espacio
                                </strong>
                            </td>

                            <td>
                                @horario.fecha.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @horario.horaInicio.ToString(@"hh\:mm")
                                -
                                @horario.horaFin.ToString(@"hh\:mm")
                            </td>

                            <td>
                                @horario.Taller?.nombre
                            </td>

                            <td>
                                @horario.Taller?.instructor
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>