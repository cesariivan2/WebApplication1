@model WebApplication1.Models.HorarioTaller

@{
    ViewData["Title"] = "Editar horario";

    var talleres = ViewBag.Talleres
        as IEnumerable<WebApplication1.Models.Taller>;
}

<div class="registration-page">

    <a asp-controller="HorariosTaller"
       asp-action="Index"
       class="back-link">
        <i class="bi bi-arrow-left"></i>
        Volver a horarios
    </a>

    <div class="registration-card">

        <div class="registration-header">

            <span class="detail-badge">
                DATA CODE 2.0
            </span>

            <h1>Editar horario</h1>

            <p>
                Modifica la información del horario seleccionado.
            </p>

        </div>

        <div class="registration-body">

            <form asp-controller="HorariosTaller"
                  asp-action="Edit"
                  method="post">

                <input type="hidden"
                       asp-for="id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="mb-3">

                    <label asp-for="tallerId"
                           class="form-label">
                        Taller
                    </label>

                    <select asp-for="tallerId"
                            class="form-select">

                        @if (talleres != null)
                        {
                            foreach (var taller in talleres)
                            {
                                <option value="@taller.id">
                                    @taller.nombre
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="tallerId"
                          class="text-danger"></span>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="fecha"
                               class="form-label">
                            Fecha
                        </label>

                        <input asp-for="fecha"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="fecha"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Espacio"
                               class="form-label">
                            Espacio
                        </label>

                        <input asp-for="Espacio"
                               class="form-control" />

                        <span asp-validation-for="Espacio"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="horaInicio"
                               class="form-label">
                            Hora de inicio
                        </label>

                        <input asp-for="horaInicio"
                               type="time"
                               class="form-control" />

                        <span asp-validation-for="horaInicio"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="horaFin"
                               class="form-label">
                            Hora de finalización
                        </label>

                        <input asp-for="horaFin"
                               type="time"
                               class="form-control" />

                        <span asp-validation-for="horaFin"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="CupoMatutino"
                               class="form-label">
                            Cupo matutino
                        </label>

                        <input asp-for="CupoMatutino"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="CupoMatutino"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="CupoVespertino"
                               class="form-label">
                            Cupo vespertino
                        </label>

                        <input asp-for="CupoVespertino"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="CupoVespertino"
                              class="text-danger"></span>

                    </div>

                </div>

                <button type="submit"
                        class="btn btn-register">

                    <i class="bi bi-save"></i>
                    Guardar cambios

                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
