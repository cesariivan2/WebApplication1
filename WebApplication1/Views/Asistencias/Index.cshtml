@model IEnumerable<Asistencia>

@{
    ViewData["Title"] = "Asistencias";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>
                <i class="bi bi-clipboard-check"></i>
                Asistencias
            </h1>
            <p class="text-muted mb-0">
                Control de asistencia de DATA CODE 2.0
            </p>
        </div>

        <a asp-action="Resumen"
           class="btn btn-dark">
            <i class="bi bi-bar-chart"></i>
            Resumen
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Todavía no hay registros de asistencia.
            Puedes registrar asistencia desde la agenda o desde un horario.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Alumno</th>
                        <th>Taller</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Registro</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var asistencia in Model)
                    {
                        <tr>
                            <td>
                                @asistencia.Inscripcion?.alumno?.Nombre
                            </td>

                            <td>
                                @asistencia.Inscripcion?
                                    .horarioTaller?
                                    .Taller?
                                    .nombre
                            </td>

                            <td>
    @if (asistencia.Inscripcion?.horarioTaller != null)
    {
        @asistencia.Inscripcion.horarioTaller.fecha.ToString("dd/MM/yyyy")
    }
</td>

                            <td>
                                @if (asistencia.Presente)
                                {
                                    <span class="badge bg-success">
                                        Presente
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Ausente
                                    </span>
                                }
                            </td>

                            <td>
                                @asistencia.FechaRegistro
                                    .ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@asistencia.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Ver
                                </a>

                                <a asp-action="Registrar"
                                   asp-route-inscripcionId="@asistencia.InscripcionId"
                                   class="btn btn-sm btn-outline-secondary">
                                    Modificar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>