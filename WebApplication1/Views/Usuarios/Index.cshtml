@model IEnumerable<WebApplication1.Models.UsuarioListaViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container py-4">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>
            <h1>
                <i class="bi bi-person-gear"></i>
                Usuarios
            </h1>

            <p class="text-muted mb-0">
                Administración de cuentas y roles
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-person-plus"></i>
            Crear usuario
        </a>

    </div>


    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No existen usuarios.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Correo</th>
                        <th>Rol</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var usuario in Model)
                    {
                        <tr>

                            <td>
                                <i class="bi bi-person-circle"></i>

                                @usuario.Email
                            </td>

                            <td>

                                @if (usuario.Roles.Contains("Administrador"))
                                {
                                    <span class="badge bg-danger">
                                        Administrador
                                    </span>
                                }
                                else if (usuario.Roles.Contains("Alumno"))
                                {
                                    <span class="badge bg-primary">
                                        Alumno
                                    </span>
                                }
                                else if (usuario.Roles.Contains("Tallerista"))
                                {
                                    <span class="badge bg-success">
                                        Tallerista
                                    </span>
                                }
                                else if (usuario.Roles.Contains("Comite"))
                                {
                                    <span class="badge bg-warning text-dark">
                                        Comité
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @usuario.Roles
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>