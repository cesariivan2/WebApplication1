@model WebApplication1.Models.CrearUsuarioViewModel

@{
    ViewData["Title"] = "Crear usuario";
}

<div class="container py-4"
     style="max-width: 750px;">

    <a asp-action="Index"
       class="btn btn-link ps-0 mb-3">

        <i class="bi bi-arrow-left"></i>
        Volver
    </a>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <h1 class="mb-4">
                <i class="bi bi-person-plus"></i>
                Crear usuario
            </h1>


            <form asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">
                        Correo
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="usuario@datacode.mx" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Password"
                           class="form-label">
                        Contraseña
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control" />

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        Mínimo 6 caracteres e incluye al menos
                        una letra minúscula y un número.
                    </div>

                </div>


                <div class="mb-4">

                    <label asp-for="Rol"
                           class="form-label">
                        Rol
                    </label>

                    <select asp-for="Rol"
                            class="form-select"
                            id="rolUsuario">

                        <option value="">
                            Selecciona un rol
                        </option>

                        <option value="Alumno">
                            Alumno
                        </option>

                        <option value="Tallerista">
                            Tallerista
                        </option>

                        <option value="Comite">
                            Comité
                        </option>

                        <option value="Administrador">
                            Administrador
                        </option>

                    </select>

                    <span asp-validation-for="Rol"
                          class="text-danger">
                    </span>

                </div>


                <!-- ==================================
                     DATOS EXCLUSIVOS DEL ALUMNO
                =================================== -->
                <div id="datosAlumno"
                     style="display:none;">

                    <hr />

                    <h5 class="mb-3">
                        Datos del alumno
                    </h5>


                    <div class="mb-3">

                        <label asp-for="Nombre"
                               class="form-label">
                            Nombre completo
                        </label>

                        <input asp-for="Nombre"
                               class="form-control" />

                        <span asp-validation-for="Nombre"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Matricula"
                               class="form-label">
                            Matrícula
                        </label>

                        <input asp-for="Matricula"
                               class="form-control" />

                        <span asp-validation-for="Matricula"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-4">

                        <label asp-for="Turno"
                               class="form-label">
                            Turno
                        </label>

                        <select asp-for="Turno"
                                class="form-select">

                            <option value="">
                                Selecciona turno
                            </option>

                            <option value="Matutino">
                                Matutino
                            </option>

                            <option value="Vespertino">
                                Vespertino
                            </option>

                        </select>

                        <span asp-validation-for="Turno"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-save"></i>
                    Crear cuenta
                </button>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        function actualizarFormularioAlumno() {

            const rol =
                document.getElementById("rolUsuario").value;

            const datosAlumno =
                document.getElementById("datosAlumno");

            if (rol === "Alumno") {
                datosAlumno.style.display = "block";
            }
            else {
                datosAlumno.style.display = "none";
            }
        }

        document
            .getElementById("rolUsuario")
            .addEventListener(
                "change",
                actualizarFormularioAlumno
            );

        actualizarFormularioAlumno();
    </script>
}