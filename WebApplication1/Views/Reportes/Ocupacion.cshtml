@model IEnumerable<ReporteOcupacionViewModel>

@{
    ViewData["Title"] = "Ocupación";
}

<div class="container py-4">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>

            <h1>
                <i class="bi bi-people"></i>
                Ocupación de talleres
            </h1>

            <p class="text-muted mb-0">
                Distribución equitativa por turno
            </p>

        </div>


        <a asp-action="Index"
           class="btn btn-outline-primary">

            Volver a reportes
        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No existen horarios para reportar.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th rowspan="2">
                            Taller
                        </th>

                        <th rowspan="2">
                            Fecha
                        </th>

                        <th rowspan="2">
                            Horario
                        </th>

                        <th rowspan="2">
                            Espacio
                        </th>

                        <th colspan="3"
                            class="text-center">

                            Matutino
                        </th>

                        <th colspan="3"
                            class="text-center">

                            Vespertino
                        </th>

                    </tr>


                    <tr>

                        <th>
                            Cupo
                        </th>

                        <th>
                            Inscritos
                        </th>

                        <th>
                            Disponibles
                        </th>

                        <th>
                            Cupo
                        </th>

                        <th>
                            Inscritos
                        </th>

                        <th>
                            Disponibles
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @item.Taller
                                </strong>
                            </td>

                            <td>
                                @item.Fecha.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @item.HoraInicio.ToString("hh\\:mm")
                                -
                                @item.HoraFin.ToString("hh\\:mm")
                            </td>

                            <td>
                                @item.Espacio
                            </td>


                            <td class="text-center">
                                @item.CupoMatutino
                            </td>

                            <td class="text-center">
                                @item.InscritosMatutinos
                            </td>

                            <td class="text-center">

                                @if (item.DisponiblesMatutinos <= 0)
                                {
                                    <span class="badge bg-danger">
                                        Lleno
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        @item.DisponiblesMatutinos
                                    </span>
                                }

                            </td>


                            <td class="text-center">
                                @item.CupoVespertino
                            </td>

                            <td class="text-center">
                                @item.InscritosVespertinos
                            </td>

                            <td class="text-center">

                                @if (item.DisponiblesVespertinos <= 0)
                                {
                                    <span class="badge bg-danger">
                                        Lleno
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        @item.DisponiblesVespertinos
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>