@model IEnumerable<WebApplication1.Models.Taller>

@{
    ViewData["Title"] = "Talleres";
}

<div class="page-header mb-4">
    <h1>Talleres</h1>

    <p class="text-muted">
        Explora los talleres disponibles en DATA CODE 2.0.
    </p>
</div>

<div class="row g-4">

    @foreach (var taller in Model)
    {
        <div class="col-lg-4 col-md-6">

            <div class="workshop-card h-100">

                <div class="workshop-image-placeholder">
                    <i class="bi bi-code-slash"></i>
                </div>

                <div class="workshop-body">

                    <h4>
                        @taller.nombre
                    </h4>

                    <p class="workshop-instructor">
                        <i class="bi bi-person"></i>
                        @taller.instructor
                    </p>

                    <p>
                        @taller.descripcion
                    </p>

                    <a asp-controller="Talleres"
                       asp-action="Details"
                       asp-route-id="@taller.id"
                       class="btn workshop-btn">

                        Ver taller
                    </a>

                </div>

            </div>

        </div>
    }

</div>
