@model TorneoVideojuego

@{
    ViewData["Title"] = "Detalle del torneo";

    var participantes =
        ViewBag.Participantes as List<ParticipanteTorneo>
        ?? new List<ParticipanteTorneo>();

    var partidas =
        ViewBag.Partidas as List<PartidaTorneo>
        ?? new List<PartidaTorneo>();
}

<div class="container py-4">

    <a asp-action="Index"
       class="btn btn-link ps-0 mb-3">

        <i class="bi bi-arrow-left"></i>
        Volver a torneos
    </a>


    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <span class="badge bg-primary mb-2">
                        @Model.Videojuego
                    </span>

                    <h1>
                        @Model.Nombre
                    </h1>

                </div>

                @if (Model.Estado == "Abierto")
                {
                    <span class="badge bg-success fs-6">
                        Abierto
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary fs-6">
                        @Model.Estado
                    </span>
                }

            </div>

            <hr />

            <div class="row">

                <div class="col-md-6">

                    <p>
                        <strong>Plataforma:</strong>
                        @Model.Plataforma
                    </p>

                    <p>
                        <strong>Formato:</strong>
                        @Model.Formato
                    </p>

                    <p>
                        <strong>Lugar:</strong>
                        @Model.Lugar
                    </p>

                </div>

                <div class="col-md-6">

                    <p>
                        <strong>Inicio:</strong>
                        @Model.FechaInicio.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    @if (Model.FechaFin != null)
                    {
                        <p>
                            <strong>Fin:</strong>
                            @Model.FechaFin.Value.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    }

                    <p>
                        <strong>Participantes:</strong>
                        @participantes.Count / @Model.CupoMaximo
                    </p>

                </div>

            </div>


            @if (User.IsInRole("Alumno") &&
                 Model.Estado == "Abierto")
            {
                <hr />

                <div class="d-flex flex-wrap gap-2">

                    <form asp-action="Inscribirse"
                          asp-route-id="@Model.Id"
                          method="post">

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-person-plus"></i>
                            Inscribirme
                        </button>

                    </form>

                    <form asp-action="CancelarInscripcion"
                          asp-route-id="@Model.Id"
                          method="post">

                        <button type="submit"
                                class="btn btn-outline-danger">

                            <i class="bi bi-x-circle"></i>
                            Cancelar mi inscripción
                        </button>

                    </form>

                </div>
            }


            @if (User.IsInRole("Administrador"))
            {
                <hr />

                <div class="d-flex flex-wrap gap-2">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-primary">

                        <i class="bi bi-pencil"></i>
                        Editar torneo
                    </a>

                    @if (Model.Estado == "Abierto")
                    {
                        <form asp-action="CerrarInscripciones"
                              asp-route-id="@Model.Id"
                              method="post">

                            <button type="submit"
                                    class="btn btn-warning">

                                <i class="bi bi-lock"></i>
                                Cerrar inscripciones
                            </button>

                        </form>
                    }

                    <a asp-controller="PartidasTorneo"
                       asp-action="Index"
                       asp-route-torneoId="@Model.Id"
                       class="btn btn-dark">

                        <i class="bi bi-diagram-3"></i>
                        Administrar partidas
                    </a>

                </div>
            }

        </div>

    </div>


    <div class="row g-4">

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header">
                    <strong>
                        <i class="bi bi-people"></i>
                        Participantes
                    </strong>
                </div>

                <div class="card-body">

                    @if (!participantes.Any())
                    {
                        <div class="alert alert-info mb-0">
                            Todavía no hay participantes inscritos.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover">

                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Matrícula</th>
                                        <th>Turno</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var participante in participantes)
                                    {
                                        <tr>
                                            <td>
                                                @participante.Alumno?.Nombre
                                            </td>

                                            <td>
                                                @participante.Alumno?.Matricula
                                            </td>

                                            <td>
                                                @participante.Alumno?.Turno
                                            </td>
                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>


        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header">
                    <strong>
                        <i class="bi bi-trophy"></i>
                        Partidas
                    </strong>
                </div>

                <div class="card-body">

                    @if (!partidas.Any())
                    {
                        <div class="alert alert-info mb-0">
                            Todavía no se han generado partidas.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover">

                                <thead>
                                    <tr>
                                        <th>Ronda</th>
                                        <th>Estado</th>
                                        <th>Resultado</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var partida in partidas)
                                    {
                                        <tr>

                                            <td>
                                                @partida.Ronda
                                            </td>

                                            <td>
                                                @partida.Estado
                                            </td>

                                            <td>
                                                @if (partida.Puntaje1 != null &&
                                                     partida.Puntaje2 != null)
                                                {
                                                    <span>
                                                        @partida.Puntaje1
                                                        -
                                                        @partida.Puntaje2
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        Pendiente
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>