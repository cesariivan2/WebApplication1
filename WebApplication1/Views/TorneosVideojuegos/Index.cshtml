@model IEnumerable<TorneoVideojuego>

@{
    ViewData["Title"] = "Torneos";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">
                <i class="bi bi-controller"></i>
                Torneos de videojuegos
            </h1>

            <p class="text-muted mb-0">
                Torneos disponibles en DATA CODE 2.0
            </p>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle"></i>
                Crear torneo
            </a>
        }

    </div>


    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Actualmente no hay torneos registrados.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var torneo in Model)
            {
                <div class="col-md-6 col-xl-4">

                    <div class="card shadow-sm h-100 border-0">

                        <div class="card-body">

                            <div class="d-flex justify-content-between mb-3">

                                <span class="badge bg-primary">
                                    @torneo.Videojuego
                                </span>

                                @if (torneo.Estado == "Abierto")
                                {
                                    <span class="badge bg-success">
                                        Abierto
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @torneo.Estado
                                    </span>
                                }

                            </div>

                            <h4>
                                @torneo.Nombre
                            </h4>

                            <p class="text-muted">
                                <i class="bi bi-display"></i>
                                @torneo.Plataforma
                            </p>

                            <p>
                                <strong>Formato:</strong>
                                @torneo.Formato
                            </p>

                            <p>
                                <strong>Lugar:</strong>
                                @torneo.Lugar
                            </p>

                            <p>
                                <strong>Cupo máximo:</strong>
                                @torneo.CupoMaximo
                            </p>

                            <p>
                                <strong>Inicio:</strong>
                                @torneo.FechaInicio.ToString("dd/MM/yyyy HH:mm")
                            </p>

                            @if (torneo.FechaFin != null)
                            {
                                <p>
                                    <strong>Fin:</strong>
                                    @torneo.FechaFin.Value.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            }

                        </div>


                        <div class="card-footer bg-white border-0">

                            <div class="d-grid gap-2">

                                <a asp-action="Details"
                                   asp-route-id="@torneo.Id"
                                   class="btn btn-outline-primary">

                                    <i class="bi bi-eye"></i>
                                    Ver torneo
                                </a>

                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@torneo.Id"
                                       class="btn btn-outline-secondary">

                                        <i class="bi bi-pencil"></i>
                                        Editar
                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>