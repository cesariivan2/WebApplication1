@{
    ViewData["Title"] =
        "Nueva inscripción";

    var alumnos =
        ViewBag.Alumnos
        as IEnumerable<WebApplication1.Models.Alumno>;

    var horarios =
        ViewBag.Horarios
        as IEnumerable<WebApplication1.Models.HorarioTaller>;
}

<div class="container py-4"
     style="max-width: 850px;">

    <a asp-controller="Inscripciones"
       asp-action="Index"
       class="btn btn-link ps-0 mb-3">

        <i class="bi bi-arrow-left"></i>
        Volver a inscripciones

    </a>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <h1 class="mb-2">

                <i class="bi bi-plus-circle"></i>
                Nueva inscripción

            </h1>


            <p class="text-muted mb-4">

                Selecciona el taller y horario.
                El sistema validará cupo y conflictos
                automáticamente.

            </p>


            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">

                    <i class="bi bi-exclamation-triangle-fill"></i>

                    @TempData["Error"]

                </div>
            }


            <form asp-controller="Inscripciones"
                  asp-action="Create"
                  method="post">


                @if (User.IsInRole("Administrador"))
                {
                    <div class="mb-4">

                        <label class="form-label">

                            <i class="bi bi-person"></i>
                            Alumno

                        </label>


                        <select name="alumnoId"
                                class="form-select"
                                required>

                            <option value="">
                                Selecciona un alumno
                            </option>


                            @if (alumnos != null)
                            {
                                foreach (var alumno in alumnos)
                                {
                                    <option value="@alumno.Id">

                                        @alumno.Nombre
                                        -
                                        @alumno.Matricula
                                        -
                                        @alumno.Turno

                                    </option>
                                }
                            }

                        </select>

                    </div>
                }
                else
                {
                    @if (alumnos != null)
                    {
                        var alumnoActual =
                            alumnos.FirstOrDefault();

                        if (alumnoActual != null)
                        {
                            <input type="hidden"
                                   name="alumnoId"
                                   value="@alumnoActual.Id" />


                            <div class="alert alert-light border">

                                <strong>
                                    Alumno:
                                </strong>

                                @alumnoActual.Nombre

                                <br />


                                <strong>
                                    Matrícula:
                                </strong>

                                @alumnoActual.Matricula

                                <br />


                                <strong>
                                    Turno:
                                </strong>

                                @alumnoActual.Turno

                            </div>
                        }
                    }
                }


                <div class="mb-4">

                    <label class="form-label">

                        <i class="bi bi-calendar-event"></i>

                        Taller y horario

                    </label>


                    <select name="horarioTallerId"
                            class="form-select"
                            required>

                        <option value="">
                            Selecciona un horario
                        </option>


                        @if (horarios != null)
                        {
                            foreach (var horario in horarios)
                            {
                                <option value="@horario.id">

                                    @horario.Taller?.nombre

                                    -

                                    @horario.fecha
                                        .ToString("dd/MM/yyyy")

                                    -

                                    @horario.horaInicio
                                        .ToString("hh\\:mm")

                                    a

                                    @horario.horaFin
                                        .ToString("hh\\:mm")

                                    -

                                    @horario.Espacio

                                </option>
                            }
                        }

                    </select>

                </div>


                <div class="alert alert-info">

                    <i class="bi bi-info-circle-fill"></i>

                    El sistema verificará:

                    <ul class="mb-0 mt-2">

                        <li>
                            Cupo según turno.
                        </li>

                        <li>
                            Horarios empalmados.
                        </li>

                        <li>
                            Inscripciones duplicadas.
                        </li>

                        <li>
                            Reactivación si anteriormente
                            cancelaste este mismo horario.
                        </li>

                    </ul>

                </div>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-circle"></i>
                    Confirmar inscripción

                </button>

            </form>

        </div>

    </div>

</div>