@model IEnumerable<WebApplication1.Models.Inscripcion>

@{
    ViewData["Title"] = "Inscripciones";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-check2-square"></i>
                Inscripciones
            </h1>

            @if (User.IsInRole("Alumno"))
            {
                <p class="text-muted mb-0">
                    Consulta y administra tus talleres inscritos.
                </p>
            }
            else
            {
                <p class="text-muted mb-0">
                    Inscripciones registradas en DATA CODE 2.0.
                </p>
            }
        </div>

        <a asp-controller="Inscripciones"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>
            Nueva inscripción
        </a>

    </div>


    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Exito"]
        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["Error"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No existen inscripciones registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle bg-white">

                <thead>
                    <tr>
                        <th>Alumno</th>
                        <th>Taller</th>
                        <th>Horario</th>
                        <th>Fecha de inscripción</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var inscripcion in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @(inscripcion.alumno?.Nombre ?? "Sin alumno")
                                </strong>

                                <br />

                                <small class="text-muted">
                                    @(inscripcion.alumno?.Matricula ?? "")
                                </small>

                                <br />

                                <small class="text-muted">
                                    @(inscripcion.alumno?.Turno ?? "")
                                </small>
                            </td>


                            <td>
                                <strong>
                                    @(inscripcion.horarioTaller?.Taller?.nombre ?? "Sin taller")
                                </strong>

                                <br />

                                <small class="text-muted">
                                    Instructor:
                                    @(inscripcion.horarioTaller?.Taller?.instructor ?? "Sin asignar")
                                </small>
                            </td>


                            <td>
                                @if (inscripcion.horarioTaller != null)
                                {
                                    <div>
                                        @(inscripcion.horarioTaller.fecha.ToString("dd/MM/yyyy"))
                                    </div>

                                    <small class="text-muted">
                                        @(inscripcion.horarioTaller.horaInicio.ToString("hh\\:mm"))
                                        -
                                        @(inscripcion.horarioTaller.horaFin.ToString("hh\\:mm"))
                                    </small>

                                    <br />

                                    <small class="text-muted">
                                        <i class="bi bi-geo-alt"></i>
                                        @inscripcion.horarioTaller.Espacio
                                    </small>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sin horario
                                    </span>
                                }
                            </td>


                            <td>
                                @(inscripcion.FechaInscripcion.ToString("dd/MM/yyyy HH:mm"))
                            </td>


                            <td>
                                @if (inscripcion.estado == "Confirmada")
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i>
                                        Confirmada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle"></i>
                                        @inscripcion.estado
                                    </span>
                                }
                            </td>


                            <td>
                                <div class="d-flex flex-wrap gap-2">

                                    <a asp-controller="Inscripciones"
                                       asp-action="Details"
                                       asp-route-id="@inscripcion.id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye"></i>
                                        Ver
                                    </a>

                                    @if (inscripcion.estado == "Confirmada")
                                    {
                                        <form asp-controller="Inscripciones"
                                              asp-action="Cancelar"
                                              asp-route-id="@inscripcion.id"
                                              method="post">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('¿Seguro que deseas cancelar esta inscripción?');">

                                                <i class="bi bi-x-circle"></i>
                                                Cancelar
                                            </button>

                                        </form>
                                    }

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>