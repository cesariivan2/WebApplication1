@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-4">

    <!-- ==========================================
         PORTADA
    =========================================== -->
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm">

        <div class="container-fluid py-3">

            <span class="badge bg-primary mb-3">
                UAdeO
            </span>

            <h1 class="display-5 fw-bold">
                DATA CODE 2.0
            </h1>

            <p class="fs-5 text-muted">
                Plataforma de gestión para talleres,
                inscripciones, participación, logística
                y actividades del evento.
            </p>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-primary btn-lg">

                    <i class="bi bi-box-arrow-in-right"></i>
                    Iniciar sesión
                </a>
            }
            else
            {
                <div class="alert alert-success mt-3 mb-0">

                    <i class="bi bi-person-check"></i>

                    Sesión iniciada como

                    <strong>
                        @User.Identity.Name
                    </strong>

                </div>
            }

        </div>

    </div>


    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- ==========================================
             ALUMNO
        =========================================== -->
        @if (User.IsInRole("Alumno"))
        {
            <h2 class="mb-3">
                Panel del alumno
            </h2>

            <div class="row g-4 mb-5">

                <div class="col-md-6 col-xl-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-easel fs-1 text-primary"></i>

                            <h4 class="mt-3">
                                Talleres
                            </h4>

                            <p class="text-muted">
                                Consulta los talleres disponibles.
                            </p>

                            <a asp-controller="Talleres"
                               asp-action="Index"
                               class="btn btn-primary">

                                Ver talleres
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-xl-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-check2-square fs-1 text-success"></i>

                            <h4 class="mt-3">
                                Mis inscripciones
                            </h4>

                            <p class="text-muted">
                                Consulta, crea o cancela tus inscripciones.
                            </p>

                            <a asp-controller="Inscripciones"
                               asp-action="Index"
                               class="btn btn-success">

                                Mis inscripciones
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-xl-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-person-badge fs-1 text-secondary"></i>

                            <h4 class="mt-3">
                                Mi gafete
                            </h4>

                            <p class="text-muted">
                                Consulta tu identificación para DATA CODE 2.0.
                            </p>

                            <a asp-controller="Alumnos"
                               asp-action="MiGafete"
                               class="btn btn-outline-dark">

                                Ver gafete
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-xl-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-controller fs-1 text-danger"></i>

                            <h4 class="mt-3">
                                Torneos
                            </h4>

                            <p class="text-muted">
                                Consulta torneos y participa.
                            </p>

                            <a asp-controller="TorneosVideojuegos"
                               asp-action="Index"
                               class="btn btn-outline-danger">

                                Ver torneos
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-xl-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-check2-circle fs-1 text-warning"></i>

                            <h4 class="mt-3">
                                Votaciones
                            </h4>

                            <p class="text-muted">
                                Participa en las decisiones del evento.
                            </p>

                            <a asp-controller="Votaciones"
                               asp-action="Index"
                               class="btn btn-warning">

                                Ir a votaciones
                            </a>

                        </div>
                    </div>
                </div>

            </div>
        }


        <!-- ==========================================
             TALLERISTA
        =========================================== -->
        @if (User.IsInRole("Tallerista"))
        {
            <h2 class="mb-3">
                Panel del tallerista
            </h2>

            <div class="row g-4 mb-5">

                <div class="col-md-6 col-xl-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-calendar-event fs-1 text-primary"></i>

                            <h4 class="mt-3">
                                Agenda
                            </h4>

                            <p class="text-muted">
                                Consulta horarios, talleres y participantes.
                            </p>

                            <a asp-controller="Logistica"
                               asp-action="Agenda"
                               class="btn btn-primary">

                                Ver agenda
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-xl-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-person-check fs-1 text-success"></i>

                            <h4 class="mt-3">
                                Asistencias
                            </h4>

                            <p class="text-muted">
                                Registra y consulta asistencia.
                            </p>

                            <a asp-controller="Asistencias"
                               asp-action="Index"
                               class="btn btn-success">

                                Control de asistencia
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-xl-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-building fs-1 text-secondary"></i>

                            <h4 class="mt-3">
                                Logística
                            </h4>

                            <p class="text-muted">
                                Consulta espacios y resumen operativo.
                            </p>

                            <a asp-controller="Logistica"
                               asp-action="Resumen"
                               class="btn btn-outline-dark">

                                Ver resumen
                            </a>

                        </div>
                    </div>
                </div>

            </div>
        }


        <!-- ==========================================
             COMITÉ
        =========================================== -->
        @if (User.IsInRole("Comite"))
        {
            <h2 class="mb-3">
                Panel del comité
            </h2>

            <div class="row g-4 mb-5">

                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-people fs-1 text-primary"></i>

                            <h4 class="mt-3">
                                Propuestas
                            </h4>

                            <p class="text-muted">
                                Crea, edita y consulta propuestas.
                            </p>

                            <a asp-controller="PropuestasComite"
                               asp-action="Index"
                               class="btn btn-primary">

                                Administrar propuestas
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-easel fs-1 text-success"></i>

                            <h4 class="mt-3">
                                Talleres
                            </h4>

                            <p class="text-muted">
                                Consulta y administra talleres del evento.
                            </p>

                            <a asp-controller="Talleres"
                               asp-action="Index"
                               class="btn btn-success">

                                Ver talleres
                            </a>

                        </div>
                    </div>
                </div>

            </div>
        }


        <!-- ==========================================
             ADMINISTRADOR
        =========================================== -->
        @if (User.IsInRole("Administrador"))
        {
            <h2 class="mb-3">
                Panel administrativo
            </h2>

            <div class="row g-4">

                <div class="col-md-6 col-xl-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-person-gear fs-1 text-primary"></i>

                            <h4 class="mt-3">
                                Usuarios
                            </h4>

                            <a asp-controller="Usuarios"
                               asp-action="Index"
                               class="btn btn-primary">

                                Administrar
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-xl-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-people fs-1 text-success"></i>

                            <h4 class="mt-3">
                                Alumnos
                            </h4>

                            <a asp-controller="Alumnos"
                               asp-action="Index"
                               class="btn btn-success">

                                Ver alumnos
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-xl-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-easel fs-1 text-warning"></i>

                            <h4 class="mt-3">
                                Talleres
                            </h4>

                            <a asp-controller="Talleres"
                               asp-action="Index"
                               class="btn btn-warning">

                                Administrar
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-xl-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-bar-chart-line fs-1 text-danger"></i>

                            <h4 class="mt-3">
                                Reportes
                            </h4>

                            <a asp-controller="Reportes"
                               asp-action="Index"
                               class="btn btn-danger">

                                Ver reportes
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-xl-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-calendar3 fs-1"></i>

                            <h4 class="mt-3">
                                Horarios
                            </h4>

                            <a asp-controller="HorariosTaller"
                               asp-action="Index"
                               class="btn btn-outline-dark">

                                Horarios
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-xl-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-controller fs-1"></i>

                            <h4 class="mt-3">
                                Torneos
                            </h4>

                            <a asp-controller="TorneosVideojuegos"
                               asp-action="Index"
                               class="btn btn-outline-dark">

                                Torneos
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-xl-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-calendar-event fs-1"></i>

                            <h4 class="mt-3">
                                Logística
                            </h4>

                            <a asp-controller="Logistica"
                               asp-action="Agenda"
                               class="btn btn-outline-dark">

                                Agenda
                            </a>

                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-xl-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <i class="bi bi-people-fill fs-1"></i>

                            <h4 class="mt-3">
                                Comité
                            </h4>

                            <a asp-controller="PropuestasComite"
                               asp-action="Index"
                               class="btn btn-outline-dark">

                                Propuestas
                            </a>

                        </div>
                    </div>
                </div>

            </div>
        }
    }

</div>