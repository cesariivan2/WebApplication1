@model WebApplication1.Models.Taller

@{
    ViewData["Title"] = "Eliminar taller";
}

<div class="container py-4"
     style="max-width: 750px;">

    <a asp-action="Index"
       class="btn btn-link ps-0 mb-3">

        <i class="bi bi-arrow-left"></i>
        Volver
    </a>


    <div class="card shadow-sm border-danger">

        <div class="card-body p-4">

            <h1 class="text-danger mb-3">

                <i class="bi bi-exclamation-triangle"></i>
                Eliminar taller

            </h1>


            <div class="alert alert-warning">

                ¿Seguro que quieres eliminar este taller?

            </div>


            <h3>
                @Model.nombre
            </h3>


            <p>
                @Model.descripcion
            </p>


            <p>

                <strong>
                    Instructor:
                </strong>

                @Model.instructor

            </p>


            <hr />


            <form asp-action="Delete"
                  asp-route-id="@Model.id"
                  method="post">

                <input asp-for="id"
                       type="hidden" />


                <button type="submit"
                        class="btn btn-danger">

                    <i class="bi bi-trash"></i>
                    Sí, eliminar

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancelar

                </a>

            </form>

        </div>

    </div>

</div>