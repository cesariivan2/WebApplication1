@model IEnumerable<PropuestaComite>

@{
    ViewData["Title"] = "Propuestas del comité";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">
                <i class="bi bi-people"></i>
                Propuestas del comité
            </h1>

            <p class="text-muted mb-0">
                Participación y decisiones de DATA CODE 2.0
            </p>
        </div>

        @if (User.IsInRole("Administrador") ||
             User.IsInRole("Comite"))
        {
            <a asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle"></i>
                Nueva propuesta
            </a>
        }

    </div>


    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay propuestas registradas.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var propuesta in Model)
            {
                <div class="col-md-6">

                    <div class="card shadow-sm border-0 h-100">

                        <div class="card-body">

                            <div class="d-flex justify-content-between mb-3">

                                @if (propuesta.Estado == "Abierta")
                                {
                                    <span class="badge bg-success">
                                        Abierta
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Cerrada
                                    </span>
                                }

                                <small class="text-muted">
                                    @propuesta.FechaCreacion.ToString("dd/MM/yyyy")
                                </small>

                            </div>


                            <h4>
                                @propuesta.Titulo
                            </h4>


                            <p>
                                @propuesta.Descripcion
                            </p>


                            @if (propuesta.CreadoPorUsuario != null)
                            {
                                <small class="text-muted">
                                    Creada por:
                                    @propuesta.CreadoPorUsuario.Email
                                </small>
                            }

                        </div>


                        <div class="card-footer bg-white border-0">

                            <div class="d-flex flex-wrap gap-2">

                                <a asp-action="Details"
                                   asp-route-id="@propuesta.Id"
                                   class="btn btn-outline-primary">

                                    <i class="bi bi-eye"></i>
                                    Ver
                                </a>


                                @if ((User.IsInRole("Administrador") ||
                                      User.IsInRole("Comite")) &&
                                     propuesta.Estado == "Abierta")
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@propuesta.Id"
                                       class="btn btn-outline-secondary">

                                        <i class="bi bi-pencil"></i>
                                        Editar
                                    </a>


                                    <form asp-action="Cerrar"
                                          asp-route-id="@propuesta.Id"
                                          method="post">

                                        <button type="submit"
                                                class="btn btn-outline-danger"
                                                onclick="return confirm('¿Cerrar esta propuesta? Después ya no podrá recibir votos.');">

                                            <i class="bi bi-lock"></i>
                                            Cerrar
                                        </button>

                                    </form>
                                }


                                @if (User.IsInRole("Administrador") ||
                                     User.IsInRole("Comite"))
                                {
                                    <a asp-controller="Votaciones"
                                       asp-action="Resultados"
                                       asp-route-id="@propuesta.Id"
                                       class="btn btn-dark">

                                        <i class="bi bi-bar-chart"></i>
                                        Resultados
                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>