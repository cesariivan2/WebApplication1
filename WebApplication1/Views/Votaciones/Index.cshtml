@model IEnumerable<PropuestaComite>

@{
    ViewData["Title"] = "Votaciones";

    var votosUsuario =
        ViewBag.VotosUsuario as List<int>
        ?? new List<int>();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1>
                <i class="bi bi-check2-square"></i>
                Votaciones
            </h1>

            <p class="text-muted">
                Participa en las decisiones de DATA CODE 2.0
            </p>

        </div>


        <a asp-action="MisVotos"
           class="btn btn-outline-primary">

            <i class="bi bi-clock-history"></i>
            Mis votos
        </a>

    </div>


    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay propuestas abiertas para votar.
        </div>
    }


    <div class="row g-4">

        @foreach (var propuesta in Model)
        {
            bool yaVoto =
                votosUsuario.Contains(propuesta.Id);


            <div class="col-md-6">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body">

                        <span class="badge bg-success mb-2">
                            Votación abierta
                        </span>


                        <h4>
                            @propuesta.Titulo
                        </h4>


                        <p>
                            @propuesta.Descripcion
                        </p>


                        <small class="text-muted">
                            Publicada:
                            @propuesta.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                        </small>

                    </div>


                    <div class="card-footer bg-white border-0">

                        @if (yaVoto)
                        {
                            <button class="btn btn-success"
                                    disabled>

                                <i class="bi bi-check-circle"></i>
                                Voto registrado
                            </button>
                        }
                        else
                        {
                            <a asp-action="Votar"
                               asp-route-id="@propuesta.Id"
                               class="btn btn-primary">

                                <i class="bi bi-check2-circle"></i>
                                Votar
                            </a>
                        }


                        <a asp-controller="PropuestasComite"
                           asp-action="Details"
                           asp-route-id="@propuesta.Id"
                           class="btn btn-outline-secondary">

                            Ver propuesta
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>