@model IEnumerable<VotoPropuesta>

@{
    ViewData["Title"] = "Mis votos";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1>
                <i class="bi bi-clock-history"></i>
                Mis votos
            </h1>

            <p class="text-muted mb-0">
                Historial de participación
            </p>

        </div>


        <a asp-action="Index"
           class="btn btn-outline-primary">

            Ir a votaciones
        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Todavía no has emitido ningún voto.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>
                        <th>Propuesta</th>
                        <th>Mi voto</th>
                        <th>Fecha</th>
                        <th></th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (var voto in Model)
                    {
                        <tr>

                            <td>
                                @voto.PropuestaComite?.Titulo
                            </td>


                            <td>

                                @if (voto.Opcion == "A favor")
                                {
                                    <span class="badge bg-success">
                                        A favor
                                    </span>
                                }
                                else if (voto.Opcion == "En contra")
                                {
                                    <span class="badge bg-danger">
                                        En contra
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Abstención
                                    </span>
                                }

                            </td>


                            <td>
                                @voto.FechaVoto.ToString("dd/MM/yyyy HH:mm")
                            </td>


                            <td>

                                @if (voto.PropuestaComite != null)
                                {
                                    <a asp-controller="PropuestasComite"
                                       asp-action="Details"
                                       asp-route-id="@voto.PropuestaComiteId"
                                       class="btn btn-sm btn-outline-primary">

                                        Ver propuesta
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>