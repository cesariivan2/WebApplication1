<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DATA CODE 2.0</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    <div class="app-layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="sidebar-logo">
                <div class="uadeo-title">UAdeO</div>
                <small>Unidad Regional Guamúchil</small>
            </div>

            <div class="brand">
                <i class="bi bi-code-slash"></i>
                <span>DATA <strong>CODE</strong> 2.0</span>
            </div>

            <nav class="sidebar-menu">

                <a asp-controller="Home" asp-action="Index" class="menu-link active">
                    <i class="bi bi-house-door-fill"></i>
                    Inicio
                </a>

                <a asp-controller="Talleres" asp-action="Index" class="menu-link">
                    <i class="bi bi-clipboard-check"></i>
                    Talleres
                </a>

                <a asp-controller="Inscripciones"
                   asp-action="Index"
                   class="menu-link">
                    <i class="bi bi-check2-square"></i>
                    Inscripciones
                </a>

                <a href="#" class="menu-link">
                    <i class="bi bi-person-badge"></i>
                    Mi gafete
                </a>

                <a href="#" class="menu-link">
                    <i class="bi bi-trophy"></i>
                    Torneo
                </a>

                <a href="#" class="menu-link">
                    <i class="bi bi-people"></i>
                    Comité
                </a>

                <a href="#" class="menu-link">
                    <i class="bi bi-bell"></i>
                    Avisos
                </a>

                <a href="#" class="menu-link">
                    <i class="bi bi-person-circle"></i>
                    Mi perfil
                </a>

            </nav>

            <div class="sidebar-footer">
                <small>ROL: ALUMNO</small>

                <a href="#" class="menu-link mt-3">
                    <i class="bi bi-box-arrow-left"></i>
                    Cerrar sesión
                </a>
            </div>

        </aside>

        <!-- CONTENIDO -->
        <main class="main-content">

            <!-- NAVBAR SUPERIOR -->
            <header class="topbar">

                <div class="topbar-links">
                    <a href="#" class="active">Inicio</a>
                    <a href="#">Talleres</a>
                    <a asp-controller="Inscripciones"
                       asp-action="Index">
                        Inscripciones
                    </a>
                    <a href="#">Torneo</a>
                    <a href="#">Comité</a>
                    <a href="#">Gafetes</a>
                    <a href="#">Avisos</a>
                </div>

                <div class="topbar-user">
                    <i class="bi bi-bell"></i>

                    <div class="user-circle">
                        JP
                    </div>

                    <span>Juan Pérez</span>
                    <i class="bi bi-chevron-down"></i>
                </div>

            </header>

            <div class="page-content">
                @RenderBody()
            </div>

        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>