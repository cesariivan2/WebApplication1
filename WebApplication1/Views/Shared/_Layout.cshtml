<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - DATA CODE 2.0
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body>

<div class="app-layout">

    <!-- ==========================================
         SIDEBAR
    =========================================== -->
    <aside class="sidebar">

        <div class="sidebar-logo">

            <div class="uadeo-title">
                UAdeO
            </div>

            <small>
                Unidad Regional Guamúchil
            </small>

        </div>


        <div class="brand">
            DATA CODE 2.0
        </div>


        <nav class="sidebar-menu">

            <!-- INICIO -->
            <a asp-controller="Home"
               asp-action="Index"
               class="menu-link">

                <i class="bi bi-house"></i>
                Inicio

            </a>


            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- ==================================
                     ALUMNO
                =================================== -->
                @if (User.IsInRole("Alumno"))
                {
                    <a asp-controller="Talleres"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-easel"></i>
                        Talleres
                    </a>


                    <a asp-controller="Inscripciones"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-check2-square"></i>
                        Mis inscripciones
                    </a>


                    <a asp-controller="Alumnos"
                       asp-action="MiGafete"
                       class="menu-link">

                        <i class="bi bi-person-badge"></i>
                        Mi gafete
                    </a>


                    <a asp-controller="TorneosVideojuegos"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-controller"></i>
                        Torneos
                    </a>


                    <a asp-controller="Votaciones"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-check2-circle"></i>
                        Votaciones
                    </a>
                }


                <!-- ==================================
                     TALLERISTA
                =================================== -->
                @if (User.IsInRole("Tallerista"))
                {
                    <a asp-controller="Talleres"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-easel"></i>
                        Talleres
                    </a>


                    <a asp-controller="Logistica"
                       asp-action="Agenda"
                       class="menu-link">

                        <i class="bi bi-calendar-event"></i>
                        Agenda
                    </a>


                    <a asp-controller="Asistencias"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-person-check"></i>
                        Asistencias
                    </a>


                    <a asp-controller="Logistica"
                       asp-action="Espacios"
                       class="menu-link">

                        <i class="bi bi-building"></i>
                        Espacios
                    </a>


                    <a asp-controller="Logistica"
                       asp-action="Resumen"
                       class="menu-link">

                        <i class="bi bi-speedometer2"></i>
                        Resumen
                    </a>
                }


                <!-- ==================================
                     COMITE
                =================================== -->
                @if (User.IsInRole("Comite"))
                {
                    <a asp-controller="PropuestasComite"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-people"></i>
                        Propuestas
                    </a>


                    <a asp-controller="Talleres"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-easel"></i>
                        Talleres
                    </a>
                }


                <!-- ==================================
                     ADMINISTRADOR
                =================================== -->
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="Usuarios"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-person-gear"></i>
                        Usuarios
                    </a>


                    <a asp-controller="Alumnos"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-people"></i>
                        Alumnos
                    </a>


                    <a asp-controller="Talleres"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-easel"></i>
                        Talleres
                    </a>


                    <a asp-controller="HorariosTaller"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-calendar3"></i>
                        Horarios
                    </a>


                    <a asp-controller="Inscripciones"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-check2-square"></i>
                        Inscripciones
                    </a>


                    <a asp-controller="Asistencias"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-person-check"></i>
                        Asistencias
                    </a>


                    <a asp-controller="Logistica"
                       asp-action="Agenda"
                       class="menu-link">

                        <i class="bi bi-calendar-event"></i>
                        Logística
                    </a>


                    <a asp-controller="PropuestasComite"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-people"></i>
                        Comité
                    </a>


                    <a asp-controller="TorneosVideojuegos"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-controller"></i>
                        Torneos
                    </a>


                    <a asp-controller="Reportes"
                       asp-action="Index"
                       class="menu-link">

                        <i class="bi bi-bar-chart-line"></i>
                        Reportes
                    </a>
                }


                <!-- ==================================
                     LOGOUT SIEMPRE VISIBLE
                =================================== -->
                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="mt-3">

                    <button type="submit"
                            class="menu-link"
                            style="
                                border: 0;
                                background: transparent;
                                width: 100%;
                                text-align: left;
                                cursor: pointer;
                                color: inherit;
                            ">

                        <i class="bi bi-box-arrow-right"></i>
                        Cerrar sesión

                    </button>

                </form>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="menu-link">

                    <i class="bi bi-box-arrow-in-right"></i>
                    Iniciar sesión

                </a>
            }

        </nav>

    </aside>


    <!-- ==========================================
         CONTENIDO PRINCIPAL
    =========================================== -->
    <main class="main-content">


        <!-- TOPBAR -->
        <header class="topbar">

            <div>
                <strong>
                    DATA CODE 2.0
                </strong>
            </div>


            <div class="topbar-user">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <i class="bi bi-person-circle"></i>

                    <span>
                        @User.Identity.Name
                    </span>


                    @if (User.IsInRole("Administrador"))
                    {
                        <span class="badge bg-danger">
                            Administrador
                        </span>
                    }
                    else if (User.IsInRole("Alumno"))
                    {
                        <span class="badge bg-primary">
                            Alumno
                        </span>
                    }
                    else if (User.IsInRole("Tallerista"))
                    {
                        <span class="badge bg-success">
                            Tallerista
                        </span>
                    }
                    else if (User.IsInRole("Comite"))
                    {
                        <span class="badge bg-warning text-dark">
                            Comité
                        </span>
                    }
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login">

                        <i class="bi bi-box-arrow-in-right"></i>
                        Iniciar sesión

                    </a>
                }

            </div>

        </header>


        <!-- CONTENIDO -->
        <div class="page-content">

            @RenderBody()

        </div>

    </main>

</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true">
</script>


@await RenderSectionAsync(
    "Scripts",
    required: false
)

</body>

</html>