    <a asp-controller="Home"
       asp-action="Index"
       class="menu-link">
        <i class="bi bi-house"></i>
        Inicio
    </a>

    @if (User.Identity?.IsAuthenticated == true)
    {
        @if (User.IsInRole("Alumno"))
        {
            <a asp-controller="Talleres"
               asp-action="Index"
               class="menu-link">
                <i class="bi bi-code-square"></i>
                Talleres
            </a>

            <a asp-controller="Inscripciones"
               asp-action="Index"
               class="menu-link">
                <i class="bi bi-check2-square"></i>
                Inscripciones
            </a>
        }

        @if (User.IsInRole("Tallerista"))
        {
            <a asp-controller="Talleres"
               asp-action="Index"
               class="menu-link">
                <i class="bi bi-easel"></i>
                Talleres
            </a>
        }

        @if (User.IsInRole("Comite"))
        {
            <a asp-controller="Home"
               asp-action="Index"
               class="menu-link">
                <i class="bi bi-people"></i>
                Comité
            </a>
        }

        @if (User.IsInRole("Administrador"))
        {
            <a asp-controller="Alumnos"
